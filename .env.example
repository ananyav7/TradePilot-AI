# Copy to .env and fill in credentials only when a corresponding integration is implemented.
APP_NAME=TradePilot AI
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./data/tradepilot.db
API_HOST=127.0.0.1
API_PORT=8000
PAPER_TRADING_ENABLED=true
LIVE_TRADING_ENABLED=false
UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:8000/auth/callback
UPSTOX_API_TIMEOUT_SECONDS=10
UPSTOX_MAX_READ_RETRIES=3
UPSTOX_INSTRUMENT_CACHE_PATH=data/cache/upstox_nse.json.gz
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
AI_PROVIDER=disabled
AI_MODEL=
AI_API_KEY=
AI_TIMEOUT_SECONDS=20
RESEARCH_MARKET_NEWS_FEEDS=["https://www.business-standard.com/rss/markets-106.rss"]
# JSON mapping from NSE symbol to issuer/exchange RSS feed URLs, for example {"SYMBOL":["https://www.nseindia.com/path/to/feed.xml"]}
RESEARCH_ANNOUNCEMENT_FEEDS={}
RISK_STARTING_CAPITAL=3000
RISK_PER_TRADE=0.005
RISK_MAX_OPEN_POSITIONS=1
RISK_MAX_PORTFOLIO_EXPOSURE=1.0
RISK_MIN_REWARD_TO_RISK=1.5
RISK_DAILY_LOSS_LIMIT=0.015
RISK_MAX_MARKET_DATA_AGE_MINUTES=1440
RISK_LEVERAGE_ENABLED=false
RISK_DERIVATIVES_ENABLED=false
# Fee inputs are configurable estimates; confirm current broker/exchange charges.
RISK_BROKERAGE_RATE=0.0003
RISK_BROKERAGE_CAP_PER_LEG=20
RISK_STT_SELL_RATE=0.001
RISK_EXCHANGE_RATE=0.0000297
RISK_SEBI_RATE=0.000001
RISK_GST_RATE=0.18
RISK_STAMP_BUY_RATE=0.00015
RISK_DEPOSITORY_SELL_FEE=0
PAPER_SLIPPAGE_BPS=10
PAPER_MAX_QUOTE_AGE_SECONDS=30
DAILY_SCHEDULER_ENABLED=true
SCHEDULER_MONITOR_INTERVAL_MINUTES=5
